{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACF documentary E2E aggregate, not logical runtime contracts",
  "type": "object",
  "required": [
    "revision",
    "synthetic_only",
    "runtime_effects_authorized",
    "plans",
    "blocks",
    "scenarios"
  ],
  "properties": {
    "revision": {
      "const": "ACF-1.0.0-r1"
    },
    "synthetic_only": {
      "const": true
    },
    "runtime_effects_authorized": {
      "const": false
    },
    "plans": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "plan_id",
          "plan_revision",
          "athlete_id",
          "sessions",
          "planned_distribution"
        ],
        "properties": {
          "sessions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "session_id",
                "recipe_ref",
                "athlete_id",
                "day",
                "start",
                "prescription"
              ]
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "athlete_id",
          "initial_plan_ref",
          "reasoning",
          "evidence",
          "execution_event",
          "new_observation",
          "resulting_decision",
          "mec",
          "preserve",
          "modify",
          "confidence",
          "autonomy",
          "next_check"
        ],
        "properties": {
          "autonomy": {
            "type": "object",
            "required": [
              "level"
            ],
            "properties": {
              "level": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              }
            }
          }
        }
      }
    }
  }
}
