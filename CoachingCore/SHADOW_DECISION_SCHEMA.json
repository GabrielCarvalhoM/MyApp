{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vilumo:bounded-shadow:decision:1",
  "title": "BSR shadow decision, with no application capability",
  "type": "object",
  "required": ["id", "traceId", "decisionType", "actionClass", "autonomyLevel", "preserve", "modify", "mec", "rationale", "jev", "evidenceRefs", "policyRefs", "confidence", "missingInputs", "mustNot", "nextCheck", "unsupportedDependency", "candidateActionsConsidered", "rejectedAlternatives", "inputVersion", "inputHash", "timestamp", "athleteFixtureId", "planId", "observationEventId", "policyVersion", "policyHash", "sourceFacts", "applied", "effect"],
  "properties": {
    "id": {"type": "string", "pattern": "^decision-[a-f0-9]{64}$"},
    "traceId": {"type": "string", "pattern": "^trace-[a-f0-9]{64}$"},
    "decisionType": {"enum": ["KEEP", "MODIFY", "ASK", "HOLD", "ABSTAIN", "NOT_SUPPORTED_YET", "CLINICAL_HUMAN_REQUIRED"]},
    "actionClass": {"type": "string"},
    "autonomyLevel": {"enum": ["AUTO_EXECUTE_ALLOWED", "SUGGEST_AND_CONFIRM", "ASK_BEFORE_DECISION", "ABSTAIN_OR_HOLD", "CLINICAL_HUMAN_REQUIRED"]},
    "preserve": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["scope"]}},
    "modify": {"type": "array", "items": {"type": "object"}},
    "mec": {"type": "object", "required": ["changeLevel", "framework"], "properties": {"changeLevel": {"type": "integer", "minimum": 0, "maximum": 6}, "framework": {"type": "string"}}},
    "rationale": {"type": "string", "minLength": 1},
    "jev": {"type": "object", "required": ["mode", "authority"], "properties": {"mode": {"const": "SHADOW"}, "authority": {"const": "NONE"}}},
    "evidenceRefs": {"type": "array", "items": {"type": "object", "required": ["reviewId"]}},
    "policyRefs": {"type": "array", "items": {"type": "object", "required": ["id", "version", "hash"]}},
    "confidence": {"type": "object", "required": ["level", "basis"], "properties": {"level": {"enum": ["NOT_ASSESSED", "MODERATE"]}, "basis": {"type": "string"}}},
    "missingInputs": {"type": "array", "items": {"type": "string"}},
    "mustNot": {"type": "array", "contains": {"const": "MUTATE_OFFICIAL_PLAN"}},
    "nextCheck": {"type": "object", "required": ["owner", "trigger", "exit"], "properties": {"owner": {"type": "string"}, "trigger": {"type": "string"}, "exit": {"type": "string"}}},
    "unsupportedDependency": {"type": ["string", "null"]},
    "candidateActionsConsidered": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["action", "disposition", "reason"]}},
    "rejectedAlternatives": {"type": "array", "items": {"type": "object", "required": ["action", "reason"]}},
    "inputVersion": {"type": "string"},
    "inputHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": ["string", "null"]},
    "athleteFixtureId": {"type": ["string", "null"]},
    "planId": {"type": ["string", "null"]},
    "observationEventId": {"type": ["string", "null"]},
    "policyVersion": {"type": "string"},
    "policyHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceFacts": {"type": "object", "required": ["provenance", "event", "observation", "completed", "inferred", "responseHistory", "recoveryContext", "policyContext", "preacceptedBranch", "planContext"]},
    "applied": {"const": false},
    "effect": {"const": "SHADOW_ONLY"}
  },
  "allOf": [
    {"if": {"properties": {"decisionType": {"const": "MODIFY"}}}, "then": {"required": ["candidate"], "properties": {"modify": {"minItems": 1}, "autonomyLevel": {"const": "SUGGEST_AND_CONFIRM"}}}},
    {"if": {"properties": {"decisionType": {"enum": ["KEEP", "ASK", "HOLD", "ABSTAIN", "NOT_SUPPORTED_YET", "CLINICAL_HUMAN_REQUIRED"]}}}, "then": {"properties": {"modify": {"maxItems": 0}, "mec": {"properties": {"changeLevel": {"const": 0}}}}}},
    {"if": {"properties": {"decisionType": {"const": "KEEP"}}}, "then": {"properties": {"autonomyLevel": {"const": "AUTO_EXECUTE_ALLOWED"}, "evidenceRefs": {"minItems": 1}, "policyRefs": {"minItems": 1}}}},
    {"if": {"properties": {"decisionType": {"const": "ASK"}}}, "then": {"properties": {"autonomyLevel": {"const": "ASK_BEFORE_DECISION"}, "missingInputs": {"minItems": 1}}}},
    {"if": {"properties": {"decisionType": {"const": "CLINICAL_HUMAN_REQUIRED"}}}, "then": {"properties": {"autonomyLevel": {"const": "CLINICAL_HUMAN_REQUIRED"}}}}
  ]
}
