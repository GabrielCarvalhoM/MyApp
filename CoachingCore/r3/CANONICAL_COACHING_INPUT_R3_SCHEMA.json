  "$defs": {
    "factCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ABSENT",
            "UNKNOWN",
            "NOT_APPLICABLE",
            "KNOWN"
          ]
        },
        "origin": {
          "enum": [
            "UNSPECIFIED",
            "MEASURED",
            "SELF_REPORTED",
            "EXPLICIT_SYNTHETIC",
            "INFERRED",
            "HISTORICAL_LEARNED_PATTERN"
          ]
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "value": {},
        "derivation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "origin",
        "sourcePath"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ABSENT"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            },
            "properties": {
              "origin": {
                "const": "UNSPECIFIED"
              }
            }
          },
          "else": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "INFERRED"
              }
            }
          },
          "then": {
            "required": [
              "derivation"
            ]
          }
        }
      ]
    },
