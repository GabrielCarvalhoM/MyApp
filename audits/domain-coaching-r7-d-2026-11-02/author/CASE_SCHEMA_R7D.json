{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "R7D-CASE-1",
 "title": "R7-D corpus (independent case author)",
 "description": "Shape of an R7-D corpus file. Semantics, vocabularies and the client protocol are in INTERFACE_ONLY_R7D.md; author/check-corpus.mjs checks this shape plus dates and references.",
 "type": "object",
 "required": ["corpusRevision", "cases"],
 "properties": {
  "corpusRevision": {"type": "string"},
  "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
 },
 "$defs": {
  "oracleClass": {"enum": ["INVARIANT_ORACLE", "DOMAIN_ORACLE", "METAMORPHIC_ORACLE", "NOT_EVALUABLE_DOMAIN"]},
  "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "zonedTimestamp": {"type": "string", "pattern": "T\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?(Z|[+-]\\d{2}:\\d{2})$"},
  "case": {
   "type": "object",
   "required": ["caseId", "authorIntent", "coverageTags", "oracleClass", "intake", "timeline", "expectedDomainProperties", "metamorphicRelations", "independentAssessment", "domainNotes"],
   "additionalProperties": false,
   "properties": {
    "caseId": {"type": "string", "pattern": "^R7D-[A-Z0-9-]+$"},
    "authorIntent": {"type": "string"},
    "coverageTags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "From the list in INTERFACE_ONLY_R7D.md §7"},
    "oracleClass": {"$ref": "#/$defs/oracleClass"},
    "intake": {"$ref": "#/$defs/intake"},
    "timeline": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "expectedDomainProperties": {"type": "array", "items": {"$ref": "#/$defs/expectation"}},
    "metamorphicRelations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "independentAssessment": {
     "type": "object",
     "required": ["rationale", "preferredCoachingBehavior", "acceptableAlternatives", "concerns"],
     "properties": {
      "rationale": {"type": "string"},
      "preferredCoachingBehavior": {"type": "string"},
      "acceptableAlternatives": {"type": "array", "items": {"type": "string"}},
      "concerns": {"type": "array", "items": {"type": "string"}}
     }
    },
    "domainNotes": {"type": "string"}
   }
  },
  "intake": {
   "type": "object",
   "required": ["version", "synthetic", "purpose", "asOf", "startDate", "weeks", "athlete", "schedule"],
   "properties": {
    "version": {"const": "R6-INTAKE-1"},
    "synthetic": {"const": true},
    "purpose": {"const": "SHADOW_REFERENCE"},
    "asOf": {"$ref": "#/$defs/day"},
    "startDate": {"$ref": "#/$defs/day"},
    "weeks": {"enum": [4, 8, 12, 16]},
    "learningConsent": {"type": "boolean"},
    "timezoneOffsetMinutes": {"type": "integer"},
    "athlete": {"type": "object", "required": ["id", "eligibility", "goals"], "description": "Fields in INTERFACE_ONLY_R7D.md §3"},
    "schedule": {
     "type": "object",
     "required": ["runDays", "strengthDays"],
     "properties": {
      "runDays": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}},
      "strengthDays": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}},
      "runTurn": {"enum": ["AM", "PM"]},
      "strengthTurn": {"enum": ["AM", "PM"]},
      "runMinutes": {"type": "number"},
      "strengthMinutes": {"type": "number"},
      "longRunDay": {"type": "integer", "minimum": 0, "maximum": 6},
      "longRunMinutes": {"type": "number"},
      "sameTurnConfirmed": {"type": "boolean"},
      "temporaryPreference": {"enum": ["RUN", "STRENGTH"]}
     }
    },
    "history": {"type": "array", "items": {"type": "object"}}
   }
  },
  "sessionRef": {
   "type": "object",
   "required": ["week", "sport"],
   "properties": {
    "week": {"type": "integer", "minimum": 0},
    "sport": {"enum": ["RUN", "STRENGTH"]},
    "day": {"type": "integer", "minimum": 0, "maximum": 6},
    "role": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}
   }
  },
  "fact": {
   "type": "object",
   "properties": {
    "ref": {"$ref": "#/$defs/sessionRef"},
    "each": {"type": "object", "required": ["weeks", "sport"], "properties": {"weeks": {"oneOf": [{"type": "integer"}, {"type": "array", "items": {"type": "integer"}}]}, "sport": {"enum": ["RUN", "STRENGTH"]}, "roles": {"type": "array", "items": {"type": "string"}}}},
    "completed": {"type": "boolean"},
    "asPrescribed": {"const": true},
    "minutes": {"type": "number"},
    "fraction": {"type": "number", "exclusiveMinimum": 0},
    "firstExercises": {"type": "integer", "minimum": 0},
    "loadsByPattern": {"type": "object", "additionalProperties": {"type": "number"}},
    "exercises": {"type": "array"},
    "response": {
     "type": "object",
     "properties": {
      "performance": {"enum": ["COMPATIBLE", "UNDER", "OVER", "UNKNOWN"]},
      "recovery": {"enum": ["COMPATIBLE", "ADVERSE", "UNKNOWN"]},
      "effort": {"enum": ["ON_TARGET", "EASIER", "HARDER", "UNKNOWN"]},
      "nextDayFunction": {"enum": ["NORMAL", "IMPAIRED", "UNKNOWN"]}
     }
    },
    "observedAt": {"$ref": "#/$defs/zonedTimestamp"},
    "reportedAt": {"$ref": "#/$defs/zonedTimestamp"},
    "occurrenceDate": {"$ref": "#/$defs/day"},
    "source": {"type": "object", "properties": {"provider": {"type": "string"}, "activityId": {"type": "string"}, "quality": {"enum": ["MANUAL", "WEARABLE_FULL", "WEARABLE_PARTIAL"]}}},
    "eventId": {"type": "string"},
    "correctionOf": {"type": "string"},
    "correctedAt": {"$ref": "#/$defs/zonedTimestamp"},
    "comparable": {"type": "boolean"},
    "confounded": {"type": "boolean"}
   },
   "oneOf": [{"required": ["ref"]}, {"required": ["each"]}]
  },
  "step": {
   "type": "object",
   "required": ["stepId", "at", "event"],
   "properties": {
    "stepId": {"type": "string", "not": {"const": "GENERATE"}},
    "at": {"oneOf": [
     {"$ref": "#/$defs/zonedTimestamp"},
     {"type": "object", "required": ["week", "day", "time"], "properties": {"week": {"type": "integer", "minimum": 0}, "day": {"type": "integer", "minimum": 0, "maximum": 6}, "time": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"}}}
    ]},
    "event": {
     "type": "object",
     "required": ["kind"],
     "properties": {
      "kind": {"enum": ["WEEKLY_REVIEW", "MISSED_SESSION", "PARTIAL_SESSION", "UNDERPERFORMANCE", "OVERPERFORMANCE", "PROGRESSION_NOT_TOLERATED", "PROGRESSION_TOO_EASY", "LOCAL_FATIGUE", "SYSTEMIC_FATIGUE", "SCHEDULE_CHANGE", "UNAVAILABLE_DAY", "DOUBLE_CONFLICT", "EQUIPMENT_CHANGE", "GOAL_CHANGE", "EVENT_DATE_CHANGE", "EVENT_WEEK_CONFLICT", "RETURN_AFTER_PAUSE", "EXERCISE_SUBSTITUTION", "RECOVERED"]},
      "changes": {"type": "object"},
      "interruption": {"type": "object"},
      "signals": {"type": "object"},
      "currentDemonstration": {"type": "object"},
      "substitution": {"type": "object", "required": ["exerciseRef", "reason"], "properties": {"exerciseRef": {"type": "object", "required": ["week", "day"]}, "reason": {"enum": ["SKILL_MISMATCH", "NONCLINICAL_DISCOMFORT_OR_PREFERENCE"]}}}
     }
    },
    "eligibility": {"oneOf": [{"const": "REANSWERED_NO_CHANGE"}, {"type": "object"}]},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "answer": {"type": "object", "properties": {"report": {"type": "object"}, "overrides": {"type": "array"}, "declareBreak": {"type": "object"}}},
    "targetRef": {"$ref": "#/$defs/sessionRef"},
    "clearance": {"const": "QUALIFIED_CLEARANCE"},
    "respondToOffers": {"type": "object", "properties": {"RUN_QUALITY_GRADUATION": {"enum": ["ACCEPT", "DECLINE"]}, "LADDER_STEP": {"enum": ["ACCEPT", "DECLINE"]}}},
    "confirmPendingLoads": {"type": "boolean"},
    "learningConsent": {"type": "boolean"},
    "adoptProposal": {"type": "boolean"},
    "note": {"type": "string"}
   }
  },
  "expectation": {
   "type": "object",
   "required": ["expectationId", "atStep", "oracleClass", "assert", "rationale"],
   "properties": {
    "expectationId": {"type": "string"},
    "atStep": {"type": "string", "description": "GENERATE or a stepId of the case"},
    "oracleClass": {"$ref": "#/$defs/oracleClass"},
    "rationale": {"type": "string"},
    "assert": {
     "type": "object",
     "required": ["type"],
     "properties": {
      "type": {"enum": ["STATUS_IN", "VALIDITY_IS", "QUESTION_KIND_IS", "NO_PRESCRIPTION", "ROLE_ABSENT", "ROLE_PRESENT", "PHASE_IS", "ROLE_MINUTES_COMPARE", "JUDGED"]},
      "oneOf": {"type": "array", "items": {"type": "string"}},
      "value": {"type": ["string", "null"]},
      "weeks": {"type": "array", "items": {"type": "integer"}},
      "week": {"type": "integer"},
      "otherWeek": {"type": "integer"},
      "sport": {"enum": ["RUN", "STRENGTH"]},
      "roles": {"type": "array", "items": {"type": "string"}},
      "role": {"type": "string"},
      "op": {"enum": ["<=", "<", ">=", "=="]},
      "statement": {"type": "string"}
     }
    }
   }
  },
  "relation": {
   "type": "object",
   "required": ["relation"],
   "properties": {
    "relation": {"enum": ["PERMUTE_OBSERVATIONS", "DUPLICATE_SECOND_SOURCE", "RENAME_OPAQUE_IDS", "LOAD_CONVENTION_EQUIVALENT", "RESEND", "CARRIER_CLINICAL", "CARRIER_HOLD", "CONSENT_OFF", "CALENDAR_SHIFT", "VARIANT"]},
    "atStep": {"type": "string"},
    "variant": {"type": "object", "properties": {"intakePatch": {"type": "object"}, "timeline": {"type": "array", "items": {"$ref": "#/$defs/step"}}}},
    "compareAtStep": {"type": "string"},
    "expect": {"enum": ["SAME_PLAN", "NOT_HIGHER_RUN_LOAD", "NOT_LOWER_RUN_LOAD"]},
    "rationale": {"type": "string"}
   }
  }
 }
}
